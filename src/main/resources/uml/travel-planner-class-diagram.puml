@startuml
title Travel Planner System - Complete Class Diagram

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 35

package "travelplanner" {
    class Main {
        +{static} main(args: String[]): void
    }
}

package "travelplanner.model" {
    enum WeatherState {
        SUNNY
        CLOUDY
        RAINY
        SNOWY
    }

    class City {
        -name: String
        -population: int
        -area: double
        -currentTemperature: double
        -currentWeatherState: WeatherState
        +City()
        +City(other: City)
        +getName(): String
        +getPopulation(): int
        +getArea(): double
        +getCurrentTemperature(): double
        +getCurrentWeatherState(): WeatherState
    }
}

package "travelplanner.repository" {
    class CityRepository <<Singleton>> {
        -{static} INSTANCE: CityRepository
        -cities: List<City>
        -CityRepository()
        +{static} getInstance(): CityRepository
        +getCities(): List<City>
        +updateRandomCityWeather(): void
        +getWeatherCounts(): Map<WeatherState, Integer>
        -loadCities(): List<City>
    }
}

package "travelplanner.strategy" {
    interface SortStrategy <<Strategy>> {
        +sort(cities: List<City>): List<City>
    }

    class NameSortStrategy {
        +sort(cities: List<City>): List<City>
    }

    class PopulationSortStrategy {
        +sort(cities: List<City>): List<City>
    }

    class AreaSortStrategy {
        +sort(cities: List<City>): List<City>
    }
}

package "travelplanner.iterator" {
    interface CityIterator <<Iterator>> {
        +hasNext(): boolean
        +next(): City
    }

    class WeatherFilteredCollection {
        -cities: List<City>
        +createSunnyIterator(): CityIterator
        +createCloudyIterator(): CityIterator
        +createRainyIterator(): CityIterator
        +createSnowyIterator(): CityIterator
    }

    class SunnyCityIterator {
        -cities: List<City>
        -currentIndex: int
        +hasNext(): boolean
        +next(): City
        -findNextIndex(startIndex: int): int
    }

    class CloudyCityIterator {
        -cities: List<City>
        -currentIndex: int
        +hasNext(): boolean
        +next(): City
        -findNextIndex(startIndex: int): int
    }

    class RainyCityIterator {
        -cities: List<City>
        -currentIndex: int
        +hasNext(): boolean
        +next(): City
        -findNextIndex(startIndex: int): int
    }

    class SnowyCityIterator {
        -cities: List<City>
        -currentIndex: int
        +hasNext(): boolean
        +next(): City
        -findNextIndex(startIndex: int): int
    }
}

package "travelplanner.observer" {
    interface WeatherObserver <<Observer>> {
        +updateWeatherData(): void
    }

    interface WeatherSubject <<Subject>> {
        +attach(observer: WeatherObserver): void
        +detach(observer: WeatherObserver): void
        +notifyObservers(): void
    }

    class WeatherReportProvider <<Concrete Subject>> {
        -observers: List<WeatherObserver>
        -cityRepository: CityRepository
        -workerThread: Thread
        +attach(observer: WeatherObserver): void
        +detach(observer: WeatherObserver): void
        +notifyObservers(): void
        +start(): void
        +stop(): void
        +run(): void
    }
}

package "travelplanner.decorator" {
    interface PlannableCity <<Component>> {
        +getDescription(): String
        +getTotalCost(): double
        +getTotalHours(): double
    }

    class BaseCityPlan <<Concrete Component>> {
        -city: City
        +getDescription(): String
        +getTotalCost(): double
        +getTotalHours(): double
    }

    abstract class ActivityDecorator <<Decorator>> {
        #wrappedPlan: PlannableCity
    }

    class MuseumVisitDecorator {
        +getDescription(): String
        +getTotalCost(): double
        +getTotalHours(): double
    }

    class ShoppingMallVisitDecorator {
        +getDescription(): String
        +getTotalCost(): double
        +getTotalHours(): double
    }

    class ParkVisitDecorator {
        +getDescription(): String
        +getTotalCost(): double
        +getTotalHours(): double
    }

    class CityCenterVisitDecorator {
        +getDescription(): String
        +getTotalCost(): double
        +getTotalHours(): double
    }
}

package "travelplanner.view" {
    class MainFrame <<Concrete Observer>> {
        -allCitiesListModel: DefaultListModel<City>
        -weatherCitiesListModel: DefaultListModel<City>
        -sortOptionsComboBox: JComboBox<String>
        -weatherFilterComboBox: JComboBox<WeatherState>
        -weatherReportProvider: WeatherReportProvider
        -temperatureChartPanel: TemperatureChartPanel
        -weatherPieChartPanel: WeatherPieChartPanel
        +MainFrame()
        -refreshAllCitiesList(): void
        -refreshWeatherCitiesList(): void
        -getSelectedSortStrategy(): SortStrategy
        -getSelectedWeatherIterator(collection: WeatherFilteredCollection): CityIterator
        -buildPlanForSelectedCity(selectedCity: City): PlannableCity
        +updateWeatherData(): void
    }

    class TemperatureChartPanel <<Concrete Observer>> {
        -cityRepository: CityRepository
        -dataset: DefaultCategoryDataset
        +TemperatureChartPanel()
        -refreshChartData(): void
        +updateWeatherData(): void
    }

    class WeatherPieChartPanel <<Concrete Observer>> {
        -cityRepository: CityRepository
        -dataset: DefaultPieDataset<String>
        +WeatherPieChartPanel()
        -refreshChartData(): void
        +updateWeatherData(): void
    }

    class ResponsiveCityList {
        +getScrollableTracksViewportWidth(): boolean
    }

    class ViewportWidthPanel {
        +getScrollableTracksViewportWidth(): boolean
        +getScrollableTracksViewportHeight(): boolean
    }

    class CityListCellRenderer {
        -titleLabel: JLabel
        -detailsLabel: JLabel
        -weatherLabel: JLabel
        +getListCellRendererComponent(...): Component
    }

    class "CityListCellRenderer.WeatherBadge" as WeatherBadge {
        #paintComponent(graphics: Graphics): void
    }

    class UiStyles {
        +{static} createCardPanel(): JPanel
        +{static} createSectionTitle(text: String): JLabel
        +{static} styleComboBox(comboBox: JComboBox<?>): void
        +{static} styleCheckBox(checkBox: JCheckBox): void
        +{static} createInfoPanel(title: String, content: JComponent): JPanel
    }
}

' Model and repository
City --> WeatherState
CityRepository o-- City
CityRepository ..> WeatherState

' Application entry point
Main ..> MainFrame

' Strategy
SortStrategy <|.. NameSortStrategy
SortStrategy <|.. PopulationSortStrategy
SortStrategy <|.. AreaSortStrategy
MainFrame ..> SortStrategy
MainFrame ..> NameSortStrategy
MainFrame ..> PopulationSortStrategy
MainFrame ..> AreaSortStrategy

' Iterator
CityIterator <|.. SunnyCityIterator
CityIterator <|.. CloudyCityIterator
CityIterator <|.. RainyCityIterator
CityIterator <|.. SnowyCityIterator
WeatherFilteredCollection o-- City
WeatherFilteredCollection ..> CityIterator
WeatherFilteredCollection ..> SunnyCityIterator
WeatherFilteredCollection ..> CloudyCityIterator
WeatherFilteredCollection ..> RainyCityIterator
WeatherFilteredCollection ..> SnowyCityIterator
MainFrame ..> WeatherFilteredCollection
MainFrame ..> CityIterator

' Observer
WeatherSubject <|.. WeatherReportProvider
WeatherObserver <|.. MainFrame
WeatherObserver <|.. TemperatureChartPanel
WeatherObserver <|.. WeatherPieChartPanel
WeatherReportProvider o-- WeatherObserver
WeatherReportProvider --> CityRepository
WeatherReportProvider ..|> Runnable
MainFrame *-- WeatherReportProvider
MainFrame *-- TemperatureChartPanel
MainFrame *-- WeatherPieChartPanel

' Decorator
PlannableCity <|.. BaseCityPlan
PlannableCity <|.. ActivityDecorator
ActivityDecorator o-- PlannableCity
ActivityDecorator <|-- MuseumVisitDecorator
ActivityDecorator <|-- ShoppingMallVisitDecorator
ActivityDecorator <|-- ParkVisitDecorator
ActivityDecorator <|-- CityCenterVisitDecorator
BaseCityPlan --> City
MainFrame ..> PlannableCity
MainFrame ..> BaseCityPlan
MainFrame ..> MuseumVisitDecorator
MainFrame ..> ShoppingMallVisitDecorator
MainFrame ..> ParkVisitDecorator
MainFrame ..> CityCenterVisitDecorator

' View helpers
MainFrame --> ResponsiveCityList
MainFrame --> ViewportWidthPanel
MainFrame --> CityListCellRenderer
MainFrame ..> UiStyles
TemperatureChartPanel ..> UiStyles
WeatherPieChartPanel ..> UiStyles
CityListCellRenderer ..> UiStyles
CityListCellRenderer --> WeatherState
CityListCellRenderer *-- WeatherBadge
ResponsiveCityList --|> JList
ViewportWidthPanel --|> JPanel
ViewportWidthPanel ..|> Scrollable
CityListCellRenderer --|> JPanel
CityListCellRenderer ..|> ListCellRenderer
WeatherBadge --|> JLabel

@enduml
